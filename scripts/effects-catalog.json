          "name": "Attack",
          "kind": "number",
          "defaultValue": 10,
          "animatable": false,
          "min": 0.1,
          "max": 200,
          "step": 0.5,
          "unit": "ms"
        },
        {
          "key": "release",
          "name": "Release",
          "kind": "number",
          "defaultValue": 200,
          "animatable": false,
          "min": 10,
          "max": 2000,
          "step": 5,
          "unit": "ms"
