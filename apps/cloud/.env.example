# Reference for Convex deployment variables, NOT a local file loaded by Convex.
# Set each value in the dashboard or with `vp exec convex env set NAME VALUE`
# from the repository root. Keep real credentials out of source control.
# Required for authentication; match the web app's VITE_WORKOS_CLIENT_ID.
WORKOS_CLIENT_ID=
# Required only for private media storage. Account ID: 32 lowercase hex digits.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
