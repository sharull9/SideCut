# Copy to apps/web/.env.local. Vite loads it at startup/build time.
# All VITE_* values are public. Never put secrets here.
# Leave blank for the local editor without cloud features.
VITE_CONVEX_URL=
VITE_WORKOS_CLIENT_ID=
# Production requires a WorkOS authentication hostname, without https://.
VITE_WORKOS_API_HOSTNAME=
# Optional: true or false. Dev mode only applies to localhost/127.0.0.1.
VITE_WORKOS_DEV_MODE=
# Optional registered redirect URL; defaults to the current origin with a trailing /.
VITE_WORKOS_REDIRECT_URI=
