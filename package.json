{
  "name": "@sidecut/workspace",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "verify:single-stream": "vp exec node scripts/verify-single-stream.mjs",
    "verify:recent-clips": "vp exec node scripts/verify-recent-clips.mjs",
    "build:cloudflare": "vp run build:web && vp exec node scripts/prepare-cloudflare.mjs",
    "dev:cloud": "vp exec convex dev",
    "verify:live-assets-audio": "vp exec node scripts/verify-live-assets-audio.mjs",
    "verify:live-studio": "vp exec node scripts/verify-live-studio.mjs",
    "verify:cloud-teams": "vp exec node scripts/verify-cloud-teams.mjs",
    "mcp": "vp exec node scripts/sidecut-mcp.mjs",
    "cli": "vp exec node scripts/sidecut-cli.mjs",
    "dev": "vp run --filter @sidecut/web dev",
    "dev:desktop": "vp run --filter @sidecut/web build && vp run --filter @sidecut/desktop start",
    "build": "vp run --filter @sidecut/web build",
    "build:web": "vp run --filter @sidecut/web build",
    "build:desktop": "vp run --filter @sidecut/web build && vp run --filter @sidecut/desktop build",
    "preview": "vp run --filter @sidecut/web preview",
    "typecheck": "vp exec tsc --noEmit && vp run -r typecheck",
    "lint": "vp lint --deny-warnings",
    "lint:fix": "vp lint --fix",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "test": "vp test run --passWithNoTests",
    "check": "vp run format:check && vp run lint && vp run typecheck && vp run test",
    "package:desktop": "vp run build:desktop && vp run --filter @sidecut/client build && vp exec node scripts/package-desktop.mjs",
    "verify:packaged": "vp exec node scripts/verify-packaged.mjs",
    "verify:browsers": "vp exec node scripts/verify-browsers.mjs",
    "verify:recording": "vp exec node scripts/verify-recording.mjs",
    "verify:recording-desktop": "vp exec node scripts/verify-recording-desktop.mjs",
    "verify:capture-desktop": "vp exec node scripts/verify-capture-desktop.mjs",
    "verify:native-recording": "vp exec node scripts/verify-native-recording.mjs",
    "verify:native-library": "vp exec node scripts/verify-native-library.mjs",
    "verify:windows-install": "pwsh -NoProfile -File scripts/verify-windows-install.ps1",
    "verify:sqlite": "vp exec node scripts/verify-sqlite.mjs",
    "verify:filmora": "vp exec node scripts/verify-filmora.mjs",
    "verify:finishing": "vp exec node scripts/verify-finishing.mjs",
    "verify:delivery": "vp exec node scripts/verify-delivery.mjs",
    "verify:review-handoff": "vp exec node scripts/verify-review-handoff.mjs",
    "verify:rendered-review": "vp exec node scripts/verify-rendered-review.mjs",
    "verify:native-long-run": "vp exec node scripts/verify-native-long-run.mjs",
    "verify:delivery-recovery": "vp exec node scripts/verify-delivery-recovery.mjs",
    "verify:long-delivery": "vp exec node scripts/verify-long-delivery.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@sidecut/config": "workspace:*",
    "@types/node": "catalog:",
    "axe-core": "^4.14.0",
    "commander": "^15.0.0",
    "convex": "^1.48.0",
    "convex-test": "^0.0.66",
    "playwright": "^1.64.1",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "zod": "^4.6.7"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.22.1",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "^24.22.1"
  },
  "packageManager": "pnpm@11.25.0"
}
