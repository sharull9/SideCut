{
  "name": "@sidecut/desktop",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "dist/main.mjs",
  "scripts": {
    "build": "vp pack",
    "start": "vp run build && vp exec install-electron && vp exec electron .",
    "typecheck": "vp exec tsc --noEmit && vp exec tsc --noEmit -p tsconfig.preload.json"
  },
  "dependencies": {
    "ffmpeg-static": "5.3.0",
    "ffprobe-static": "3.1.0"
  },
  "devDependencies": {
    "@sidecut/assets": "workspace:*",
    "@sidecut/config": "workspace:*",
    "@sidecut/contracts": "workspace:*",
    "@sidecut/core": "workspace:*",
    "@types/node": "catalog:",
    "electron": "catalog:",
    "electron-builder": "26.18.0",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "productName": "SideCut"
}
