# Optional host overrides. Electron does not automatically load this file.
# Export values in the launching shell before running `vp run dev:desktop`.
# Leave blank to use the built renderer and supplied media executables.
# Renderer URL must use http://localhost:<port> or http://127.0.0.1:<port>.
SIDECUT_RENDERER_URL=
# Paths to alternative executable files, if needed.
SIDECUT_FFMPEG=
SIDECUT_FFPROBE=
