{
  "name": "@sidecut/workspace",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp run --filter @sidecut/web dev",
    "build": "vp run --filter @sidecut/web build",
    "preview": "vp run --filter @sidecut/web preview",
    "typecheck": "tsc --noEmit && vp run -r typecheck",
    "lint": "vp lint --deny-warnings",
    "lint:fix": "vp lint --fix",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "test": "vp test run --passWithNoTests",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@sidecut/config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": "^24.18.0"
  },
  "packageManager": "pnpm@11.25.0"
}
