# Convex CLI runs from the repository root. `vp run dev:cloud` manages .env.local.
# Use the deployment selected by `convex dev`.
CONVEX_DEPLOYMENT=
CONVEX_URL=
CONVEX_SITE_URL=

# Optional CLI/MCP overrides. Node scripts do not automatically read .env files.
# Example: node --env-file=.env scripts/sidecut-cli.mjs --help
# Leave unset to use discovery and the default author.
# SIDECUT_API_FILE=/absolute/path/to/local-api.json
# SIDECUT_APP_EXECUTABLE=/absolute/path/to/SideCut.exe
# SIDECUT_PROJECT=/absolute/path/to/project
# SIDECUT_AUTHOR=cli
# SIDECUT_HEADLESS_DIAGNOSTICS=1
